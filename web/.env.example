# Bu dosyayı ".env.local" adıyla kopyalayıp Supabase bilgilerini girin (.env.local git'e gönderilmez).
# Supabase panelinde: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bildirim anahtarının açık yarısı: node web/scripts/vapid.mjs çıktısındaki VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=
